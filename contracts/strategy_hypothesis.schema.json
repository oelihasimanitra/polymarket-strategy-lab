{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polymarket-strategy-lab.invalid/contracts/strategy_hypothesis.schema.json",
  "title": "StrategyHypothesis",
  "description": "Hypothèse de stratégie, contrat 1.0.0. Les règles entry_rules, exit_rules et risk_rules sont des descriptions humaines, pas du code exécutable. L'implémentation déterministe doit être référencée séparément par implementation et versionnée dans strategies. Le document distingue explicitement les faits, l'hypothèse, les inconnues et les biais.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "hypothesis_id",
    "trader_id",
    "observation_summary",
    "hypothesis",
    "unknowns",
    "test_plan",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "hypothesis_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "trader_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "observation_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "description": "Faits observés uniquement, avec période et références de données."
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high",
        "unknown"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "testable",
        "rejected",
        "superseded"
      ]
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "bias_risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "entry_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "description": "Description humaine. Toute règle doit être traduite en configuration déterministe et testable avant simulation."
    },
    "exit_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "risk_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "test_plan": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "description": "Expérience qui pourrait réfuter l'hypothèse, avec fenêtre, données requises et critère d'échec."
    },
    "implementation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategy_id",
            "strategy_version"
          ],
          "properties": {
            "strategy_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "strategy_version": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "supersedes_hypothesis_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    }
  }
}
